# Salin menjadi .env untuk docker compose. Nilai di bawah hanya untuk lokal.
POSTGRES_DB=transfer_db
POSTGRES_USER=transfer_user
POSTGRES_PASSWORD=local-dev-password
# Minimal 32 karakter. Untuk production pakai nilai acak: openssl rand -base64 48
JWT_SECRET=local-dev-secret-replace-me-with-a-random-value
APP_PORT=8080
DB_PORT=5432
