    {
      "name": "Rate limit",
      "item": [
        {
          "name": "14. Transfer sampai kena limit",
          "description": "Saat dijalankan lewat Run Collection, request ini mengulang dirinya sendiri sampai mendapat 429. Setiap percobaan yang berhasil memindahkan Rp1.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const attempts = Number(pm.collectionVariables.get('rateLimitAttempts')) + 1;",
                  "pm.collectionVariables.set('rateLimitAttempts', String(attempts));",
                  "if (pm.response.code === 429) {",
                  "    pm.test('status 429 dengan Retry-After', () => {",
                  "        pm.expect(pm.response.json().code).to.eql('RATE_LIMIT_EXCEEDED');",
                  "        pm.expect(Number(pm.response.headers.get('Retry-After'))).to.be.above(0);",
                  "    });",
                  "    pm.collectionVariables.set('rateLimitAttempts', '0');",
                  "} else if (attempts < 25) {",
                  "    pm.test('masih di bawah limit: status 201', () => pm.response.to.have.status(201));",
                  "    pm.execution.setNextRequest(pm.info.requestName);",
                  "} else {",
                  "    pm.test('limit seharusnya tercapai dalam 25 percobaan', () => pm.expect.fail('tidak mendapat 429'));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Idempotency-Key", "value": "{{$guid}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "http://localhost:8080/api/v1/transfers",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "v1", "transfers"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sourceAccountNumber\": \"1000000001\",\n  \"destinationAccountNumber\": \"1000000002\",\n  \"amount\": 1\n}"
            }
          }
        }
      ]
