{
  "info": {
    "name": "Transfer Service",
    "description": "Pengujian REST API transfer dana. Jalankan aplikasi dengan docker compose, lalu jalankan folder berurutan lewat Run Collection. Request 1. Login budi menyimpan token dan membuat Idempotency-Key baru, jadi jalankan request itu lebih dulu jika mencoba satu per satu.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{token}}", "type": "string" }
    ]
  },
  "variable": [
    { "key": "token", "value": "", "type": "string" },
    { "key": "idempotencyKey", "value": "", "type": "string" },
    { "key": "transferId", "value": "", "type": "string" },
    { "key": "rateLimitAttempts", "value": "0", "type": "string" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "1. Login budi",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('token diterima', () => {",
                  "    pm.expect(body.accessToken).to.be.a('string').and.not.empty;",
                  "    pm.expect(body.tokenType).to.eql('Bearer');",
                  "});",
                  "pm.collectionVariables.set('token', body.accessToken);",
                  "pm.collectionVariables.set('idempotencyKey', pm.variables.replaceIn('{{$guid}}'));",
                  "pm.collectionVariables.set('rateLimitAttempts', '0');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": { "type": "noauth" },
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "http://localhost:8080/api/v1/auth/login",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "v1", "auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"budi\",\n  \"password\": \"Password123!\"\n}"
            }
          }
        },
        {
          "name": "2. Login password salah",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 401', () => pm.response.to.have.status(401));",
                  "pm.test('code INVALID_CREDENTIALS', () => pm.expect(pm.response.json().code).to.eql('INVALID_CREDENTIALS'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": { "type": "noauth" },
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "http://localhost:8080/api/v1/auth/login",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "v1", "auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"budi\",\n  \"password\": \"salah\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Transfer berhasil dan duplicate request",
      "item": [
        {
          "name": "3. Transfer berhasil",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.test('Idempotent-Replayed false', () => pm.expect(pm.response.headers.get('Idempotent-Replayed')).to.eql('false'));",
                  "const body = pm.response.json();",
                  "pm.test('transfer SUCCESS', () => {",
                  "    pm.expect(body.status).to.eql('SUCCESS');",
                  "    pm.expect(body.amount).to.eql(150000);",
                  "});",
                  "pm.collectionVariables.set('transferId', body.transferId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Idempotency-Key", "value": "{{idempotencyKey}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "http://localhost:8080/api/v1/transfers",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "v1", "transfers"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sourceAccountNumber\": \"1000000001\",\n  \"destinationAccountNumber\": \"1000000002\",\n  \"amount\": 150000,\n  \"description\": \"Bayar makan\"\n}"
            }
          }
        },
        {
          "name": "4. Retry dengan key sama",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Idempotent-Replayed true', () => pm.expect(pm.response.headers.get('Idempotent-Replayed')).to.eql('true'));",
                  "pm.test('transferId sama dengan transfer pertama', () => {",
                  "    pm.expect(pm.response.json().transferId).to.eql(pm.collectionVariables.get('transferId'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Idempotency-Key", "value": "{{idempotencyKey}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "http://localhost:8080/api/v1/transfers",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "v1", "transfers"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sourceAccountNumber\": \"1000000001\",\n  \"destinationAccountNumber\": \"1000000002\",\n  \"amount\": 150000,\n  \"description\": \"Bayar makan\"\n}"
            }
          }
        },
        {
          "name": "5. Key sama dengan nominal beda",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 409', () => pm.response.to.have.status(409));",
                  "pm.test('code IDEMPOTENCY_KEY_CONFLICT', () => pm.expect(pm.response.json().code).to.eql('IDEMPOTENCY_KEY_CONFLICT'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Idempotency-Key", "value": "{{idempotencyKey}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "http://localhost:8080/api/v1/transfers",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "v1", "transfers"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sourceAccountNumber\": \"1000000001\",\n  \"destinationAccountNumber\": \"1000000002\",\n  \"amount\": 200000,\n  \"description\": \"Bayar makan\"\n}"
            }
          }
        }
      ]
    },
