              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 400', () => pm.response.to.have.status(400));",
                  "const body = pm.response.json();",
                  "pm.test('code VALIDATION_ERROR', () => pm.expect(body.code).to.eql('VALIDATION_ERROR'));",
